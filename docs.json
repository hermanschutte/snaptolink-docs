{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Snapto Docs",
  "colors": {
    "primary": "#4A4497",
    "light": "#716BBD",
    "dark": "#302C63"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "REST API v1",
            "pages": [
              "api/overview",
              "api/profiles",
              "api/elements",
              "api/analytics"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Developer",
            "pages": [
              "mcp/overview",
              "mcp/tools"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://snapto.link"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@snapto.link"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://snapto.link"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/snaptolink"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "metadata": {
    "timestamp": true
  }
}
